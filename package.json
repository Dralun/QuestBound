{
  "name": "questbound",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:test": "node scripts/build-test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write app tests public scripts .github index.html *.ts *.mjs *.json *.md .prettierrc.json .prettierignore .node-version .npmrc --ignore-unknown",
    "format:check": "prettier --check app tests public scripts .github index.html *.ts *.mjs *.json *.md .prettierrc.json .prettierignore .node-version .npmrc --ignore-unknown",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security": "trivy fs --include-dev-deps --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --exit-code 1 --skip-dirs node_modules,tmp,dist .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run security"
  },
  "dependencies": {
    "@iconify-json/game-icons": "1.2.4",
    "@nuxt/icon": "2.6.0",
    "@nuxt/ui": "4.12.0",
    "pinia": "4.1.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
